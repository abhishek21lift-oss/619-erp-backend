{
  "name": "619-erp-backend",
  "version": "3.0.0",
  "description": "619 Fitness ERP — Express + Supabase PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12",
    "npm": ">=9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:v3": "node src/server.js",
    "dev:v3": "node --watch src/server.js",
    "worker": "node src/workers/renewal.worker.js",
    "worker:email": "node src/workers/email.worker.js",
    "worker:whatsapp": "node src/workers/whatsapp.worker.js",
    "worker:ai": "node src/workers/ai.worker.js",
    "worker:notifications": "node src/workers/notifications.worker.js",
    "worker:renewal": "node src/workers/renewal.worker.js --watch",
    "worker:all": "node src/workers/index.js",
    "lint": "eslint .",
    "migrate": "node src/db/migrate.js",
    "backfill:training-records": "node scripts/backfill-training-records.js",
    "verify:smtp": "node scripts/verify-smtp.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit --detectOpenHandles",
    "diagnose:redis": "node --require ./diagnostics/redis-trace.js src/server.js",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --forceExit",
    "verify:embeddings": "node scripts/verify-embeddings.js",
    "verify:indexes": "node scripts/verify-indexes.js",
    "e2e:setup": "bash scripts/e2e-setup.sh",
    "seed:e2e": "node scripts/seed-e2e.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@sentry/node": "^11.9.0",
    "@simplewebauthn/server": "^14.0.3",
    "@smithy/node-http-handler": "^4.13.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "googleapis": "^188.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.8",
    "read-excel-file": "^9.3.12",
    "redis": "^6.3.0",
    "resend": "^6.34.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "protobufjs": "^8.7.1",
    "sharp": "^0.35.5",
    "js-yaml": "$js-yaml",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    },
    "proxy-addr": "^2.0.8"
  }
}
